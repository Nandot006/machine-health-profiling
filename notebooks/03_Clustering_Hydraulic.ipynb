    "def cluster_metrics(X_data, labels):\n",
    "    \"\"\"The three mandatory internal metrics for one clustering result.\"\"\"\n",
    "    return {\n",
    "        \"Silhouette (↑)\": silhouette_score(X_data, labels),\n",
    "        \"Davies-Bouldin (↓)\": davies_bouldin_score(X_data, labels),\n",
    "        \"Calinski-Harabasz (↑)\": calinski_harabasz_score(X_data, labels),\n",
    "    }\n",
    "\n",
    "k_range = range(2, 11)\n",
    "rows = []\n",
    "for k in k_range:\n",
    "    km = KMeans(n_clusters=k, n_init=10, random_state=RANDOM_STATE).fit(X_scaled)\n",
    "    rows.append({\"k\": k, \"inertia\": km.inertia_, **cluster_metrics(X_scaled, km.labels_)})\n",
    "k_search = pd.DataFrame(rows).set_index(\"k\")\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 4.5))\n",
    "axes[0].plot(k_search.index, k_search[\"inertia\"], marker=\"o\", label=\"inertia\")\n",
    "axes[0].set_title(\"Elbow curve (K-Means)\")\n",
    "axes[0].set_xlabel(\"Number of clusters k\")\n",
    "axes[0].set_ylabel(\"Inertia (within-cluster SSE)\")\n",
    "axes[0].legend()\n",
    "axes[1].plot(k_search.index, k_search[\"Silhouette (↑)\"], marker=\"o\", color=\"tab:orange\", label=\"silhouette\")\n",
    "axes[1].set_title(\"Silhouette score vs k (K-Means)\")\n",
    "axes[1].set_xlabel(\"Number of clusters k\")\n",
    "axes[1].set_ylabel(\"Silhouette score\")\n",
    "axes[1].legend()\n",
    "plt.tight_layout()\n",
    "save_fig(\"05_elbow_silhouette\")\n",
    "plt.show()\n",
    "k_search.round(3)"
   ]
  },
