   "source": [
    "# Name each K-Means cluster from its dominant recorded conditions (the pattern described above).\n",
    "# Names are derived by rule rather than typed per cluster number, because cluster numbers\n",
    "# can change between scikit-learn versions while the groups themselves stay the same.\n",
    "COOLER_NAMES = {100: \"Healthy: cooler at full efficiency\",\n",
    "                20: \"Degraded: cooler at reduced efficiency\",\n",
    "                3: \"Warning: cooler close to failure\"}\n",
    "\n",
    "def name_cluster(conditions):\n",
    "    \"\"\"Plain-language name for one cluster, from the recorded conditions of its cycles.\"\"\"\n",
    "    cooler = conditions[\"cooler_pct\"].mode()[0]\n",
    "    leaking = (conditions[\"pump_leakage\"] > 0).mean()\n",
    "    if cooler == 3 and leaking > 0.5:\n",
    "        return \"Critical: cooler close to failure + pump leakage\"\n",
    "    return COOLER_NAMES[cooler]\n",
    "\n",
    "CLUSTER_NAMES = {c: name_cluster(profile[km_labels == c]) for c in range(K)}\n",
    "pd.Series(CLUSTER_NAMES, name=\"name\").rename_axis(\"cluster\").to_frame().assign(cycles=np.bincount(km_labels))"
   ]
  },
